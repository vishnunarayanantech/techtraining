<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/techstack/db"
       VERSION="2025121600"
       COMMENT="XMLDB file for local_techstack plugin"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">

    <TABLES>

        <!-- Table: mdl_tech_stack -->
        <TABLE NAME="techstack" COMMENT="Stores tech categories and users">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="tech_category" TYPE="char" LENGTH="255" NOTNULL="true"/>
                <FIELD NAME="manager" TYPE="text" NOTNULL="true"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>

        <!-- Table: mdl_map_courses -->
        <TABLE NAME="mapcourses" COMMENT="Maps tech categories to courses">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="cat_id" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="mapped_courses" TYPE="int" LENGTH="10" NOTNULL="true"/>
            </FIELDS>

            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="catid_fk" TYPE="foreign" FIELDS="cat_id" REFTABLE="tech_stack" REFFIELDS="id"/>
            </KEYS>
        </TABLE>

    </TABLES>
</XMLDB>
